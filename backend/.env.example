PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/service_crm?appName=Cluster0
# Required: same project id as the web app (VITE_FIREBASE_PROJECT_ID). Enables JWT verification without a service account.
FIREBASE_PROJECT_ID=
# Optional: Firebase Admin (displayName in ensureUserRecords, uses Admin verifyIdToken when set).
# Either: path to a JSON file (gitignore it) — FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccount.json
# Or: entire JSON on one line in FIREBASE_SERVICE_ACCOUNT= (for Render, paste in dashboard; keep private).
# On Render, set as a secret; never commit. If a key is leaked, rotate it in Google Cloud → IAM → Service accounts → Keys.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
# Optional: extra origins (production). Localhost any port is always allowed.
CORS_ORIGIN=
# Set to 1 on Render to allow https://*.onrender.com (your frontend). For stricter CORS, use CORS_ORIGIN only and omit this.
CORS_ALLOW_ONRENDER=
