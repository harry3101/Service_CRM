PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/service_crm?appName=Cluster0
# Required: same project id as the web app (VITE_FIREBASE_PROJECT_ID). Enables JWT verification without a service account.
FIREBASE_PROJECT_ID=
# Optional: service account JSON (string or file) for Firebase Admin (e.g. getUser). Not required if FIREBASE_PROJECT_ID is set.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
# Optional: extra origins (production/staging). Local http://localhost:PORT and http://127.0.0.1:PORT are always allowed (any port: 5173, 8080, etc.)
CORS_ORIGIN=
